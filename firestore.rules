rules_version = '2';

// Regole di sicurezza per Cloud Firestore
// - Albero: lo LEGGE solo chi ha fatto l'accesso con un'email in elenco (famiglia);
//           lo SCRIVE solo il proprietario.
// - Per aggiungere un familiare: crea il suo utente in Firebase Authentication
//   (email + password) e aggiungi la sua email all'elenco in lettoriAlbero().
//
// Da incollare in: Console Firebase > Firestore Database > scheda "Regole" > Pubblica

service cloud.firestore {
  match /databases/{database}/documents {

    function proprietario() {
      return request.auth != null
        && request.auth.token.email == 'menems@gmail.com';
    }

    function lettoriAlbero() {
      return request.auth != null
        && request.auth.token.email in [
          'menems@gmail.com'
          // , 'familiare@esempio.it'
        ];
    }

    // Documento dell'albero: alberi/ceni
    match /alberi/{documento} {
      allow read: if lettoriAlbero();
      allow write: if proprietario();
    }

    // skill.AI: link personali, ognuno legge e scrive SOLO i propri
    match /utenti/{uid}/skill-ai/{documento} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tutto il resto: chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
