rules_version = '2';

// Regole di sicurezza per Cloud Firestore
// - Lettura: LIBERA (chiunque può vedere l'albero, come la home)
// - Scrittura: SOLO utenti autenticati (email/password che crei tu in Firebase Authentication)
//
// Da incollare in: Console Firebase > Firestore Database > scheda "Regole" > Pubblica

service cloud.firestore {
  match /databases/{database}/documents {

    // Documento dell'albero: alberi/ceni
    match /alberi/{documento} {
      allow read: if true;
      allow write: if request.auth != null;

      // --- Variante più restrittiva (opzionale) ---
      // Per permettere la scrittura SOLO al tuo account, prendi il tuo UID
      // da Firebase Authentication (colonna "ID utente") e usa questa riga
      // al posto di quella sopra:
      // allow write: if request.auth != null && request.auth.uid == "IL_TUO_UID";
    }

    // Tutto il resto: chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
